{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",

  "properties": {
    "objects": {
      "type": "object",
      "properties": {
        "edit": {
          "type": "string",
          "enum": [".mp4, .mp3, .avi, .webm, .mkv, .mov, .wav"]
        }
      },
      "required": ["edit"],
      "additionalProperties": false
    },

    "payload": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "enum": [".mp4, .mp3, .avi, .webm, .mkv, .mov, .wav"]
        }
      },
      "required": ["target"],
      "additionalProperties": false
    }
  },

  "required": ["objects", "payload"],
  "additionalProperties": false
}
